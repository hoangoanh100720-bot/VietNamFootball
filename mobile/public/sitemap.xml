    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>

  <!-- Danh sách cầu thủ: đổi theo mỗi đợt triệu tập -->
  <url>
    <loc>https://bongda.oanh.online/players</loc>
    <lastmod>2026-09-12</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>

  <!-- Dự đoán & bảng xếp hạng: đổi theo từng trận -->
  <url>
    <loc>https://bongda.oanh.online/ai</loc>

# ==========================================================
# BACKEND — Node.js + Express
# Copy file này thành .env rồi điền giá trị thật.
# TUYỆT ĐỐI không commit file .env lên Git.
# ==========================================================

# ---------- 1. SERVER ----------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_NAME=VietNamFootball
TZ=Asia/Ho_Chi_Minh

# ---------- 2. DATABASE ----------
# DB_DRIVER quyết định app cắm vào đâu:
#   pglite   = PostgreSQL nhúng, chạy ngay, KHÔNG CẦN CÀI GÌ (dùng để học/dev)
#   postgres = PostgreSQL thật (localhost / Neon / Supabase / Railway)
# SQL viết ra giống hệt nhau -> đổi driver không phải sửa dòng code nào.
DB_DRIVER=pglite
PGLITE_DATA_DIR=./data/pgdata

# --- Chỉ dùng khi DB_DRIVER=postgres ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vnfootball
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_SSL=false
DB_POOL_MAX=10
# Dùng khi deploy (Supabase / Neon / Railway):
DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5432/vnfootball

# ---------- 3. REDIS (cache live score, AI, rate limit) ----------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
CACHE_TTL_LIVE=15
CACHE_TTL_STATIC=86400
CACHE_TTL_AI=21600

# ---------- 4. BẢO MẬT / XÁC THỰC ----------
# Sinh chuỗi ngẫu nhiên: openssl rand -hex 64
JWT_SECRET=thay_bang_chuoi_ngau_nhien_64_ky_tu
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=thay_bang_chuoi_ngau_nhien_khac_64_ky_tu
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:8081,exp://192.168.1.10:8081

# ---------- 5. RATE LIMIT ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
AI_RATE_LIMIT_MAX=20

# ---------- 6. GOOGLE GEMINI API ----------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=3

# ---------- 7. NGUỒN DỮ LIỆU BÓNG ĐÁ ----------
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_API_KEY=your_football_api_key_here
VIETNAM_TEAM_ID=26
FIFA_RANKING_URL=https://www.fifa.com/fifa-world-ranking
TRANSFERMARKT_BASE_URL=https://www.transfermarkt.com
CRAWLER_USER_AGENT=VietNamFootballBot/1.0
CRAWLER_TIMEOUT_MS=20000

# ---------- 8. CRON JOB (node-cron) ----------
CRON_ENABLED=true
CRON_TIMEZONE=Asia/Ho_Chi_Minh
CRON_SYNC_SQUAD=0 1 * * *
CRON_SYNC_PLAYERS=10 1 * * *
CRON_SYNC_FIXTURES=20 1 * * *
CRON_SYNC_RANKING=30 1 * * *
CRON_CLEANUP=0 2 * * *

# ---------- 9. LIVE SCORE (polling / websocket) ----------
# LIVE_SIMULATION=true: tự sinh diễn biến trận đấu để xem giao diện realtime
# hoạt động khi chưa có FOOTBALL_API_KEY. ĐẶT false khi dùng dữ liệu thật.
LIVE_SIMULATION=true
LIVE_POLLING_ENABLED=true
LIVE_POLLING_INTERVAL_MS=12000  # tối thiểu 5000
SOCKET_ENABLED=true
SOCKET_PATH=/socket.io
SOCKET_CORS_ORIGIN=*

# ---------- 10. FIREBASE (push notification) ----------
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nthay_bang_private_key\n-----END PRIVATE KEY-----\n"
FCM_ENABLED=false

# ---------- 11. LOG & GIÁM SÁT ----------
LOG_LEVEL=debug
LOG_DIR=./logs
SENTRY_DSN=

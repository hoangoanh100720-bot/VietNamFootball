# ============================================================================
# VIETNAMFOOTBALL — FILE BIẾN MÔI TRƯỜNG DUY NHẤT (single source of truth)
# ----------------------------------------------------------------------------
# • Copy file này thành `.env` ở GỐC repo rồi điền giá trị thật:  cp .env.example .env
# • `.env` đã có trong .gitignore — TUYỆT ĐỐI không commit.
# • Backend, worker, docker-compose và mobile đều đọc CÙNG file `.env` này
#   (cách nạp: ARCHITECTURE.md mục 16).
# • Mobile CHỈ nhận các biến tiền tố EXPO_PUBLIC_* (nhóm 17). Các biến đó bị nhúng
#   vào bundle, ai cũng đọc được → KHÔNG BAO GIỜ đặt secret có tiền tố EXPO_PUBLIC_.
# • staging/production KHÔNG dùng file này: cùng tên biến được bơm từ Secret Manager.
# • Thêm/xoá biến → sửa đồng thời file này + backend/src/config/env.ts (CI kiểm tra khớp).
# Ký hiệu chủ sở hữu:  [D1] Tech Lead/AI · [D2] Ingestion · [D3] Chấm điểm cầu thủ
#                      [D4] DB/Auth · [D5] Read-API/Test · [D6] Mobile
# ============================================================================


# ---------- 1. CHUNG & VAI TRÒ TIẾN TRÌNH [D1] ----------
NODE_ENV=development
APP_NAME=VietNamFootball
TZ=Asia/Ho_Chi_Minh
# Một image, nhiều vai trò: api | worker-ingest | worker-scoring | scheduler | all
# `all` = chạy mọi thứ trong 1 tiến trình (chỉ dùng khi dev trên máy cá nhân)
APP_ROLE=all


# ---------- 2. SERVER / GATEWAY [D1] ----------
PORT=5000
API_PREFIX=/api/v1
PUBLIC_API_URL=http://localhost:5000/api/v1
# Danh sách origin được phép, phân tách bằng dấu phẩy
CORS_ORIGIN=http://localhost:8081,exp://192.168.1.10:8081
# Số proxy đứng trước app (Load Balancer) để lấy đúng IP người dùng cho rate-limit
TRUST_PROXY=0


# ---------- 3. DATABASE — PostgreSQL [D4] ----------
# pglite  = PostgreSQL nhúng, không cần cài (chỉ để thử nhanh / unit test)
# postgres = PostgreSQL thật (docker-compose / Cloud SQL / RDS)
DB_DRIVER=postgres
PGLITE_DATA_DIR=./data/pgdata
# Ưu tiên DATABASE_URL; nếu bỏ trống thì ghép từ DB_HOST/DB_PORT/...
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/vnfootball
# Read replica cho các API chỉ đọc (bỏ trống = dùng chung primary)
DATABASE_READ_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vnfootball
DB_USER=postgres
DB_PASSWORD=change_me
DB_SSL=false
DB_POOL_MAX=10
# Truy vấn chạy quá mốc này bị huỷ (bảo vệ DB khi có query lỗi)
DB_STATEMENT_TIMEOUT_MS=5000
# Truy vấn chậm hơn mốc này bị ghi log cảnh báo (mục tiêu < 50ms)
DB_SLOW_QUERY_MS=50


# ---------- 4. REDIS [D2] ----------
# Code hiện tại đọc REDIS_URL (bỏ trống = cache trong RAM, đủ cho dev).
# Khi có BullMQ sẽ thay bằng REDIS_CACHE_URL + REDIS_QUEUE_URL bên dưới.
REDIS_URL=
# Tách 2 instance: cache (được phép xoá bớt khi đầy) và queue (BullMQ BẮT BUỘC noeviction)
REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_QUEUE_URL=redis://localhost:6380/0
REDIS_KEY_PREFIX=vnf:
CACHE_TTL_LIVE=15
CACHE_TTL_STATIC=86400
CACHE_TTL_AI=21600


# ---------- 5. XÁC THỰC [D4] ----------
# Sinh chuỗi ngẫu nhiên: openssl rand -hex 64
JWT_SECRET=thay_bang_chuoi_ngau_nhien_64_ky_tu
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=thay_bang_chuoi_ngau_nhien_khac_64_ky_tu
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
# Google OAuth2 — danh sách client ID (web, iOS, Android) được chấp nhận làm audience của idToken
GOOGLE_OAUTH_CLIENT_IDS=xxx.apps.googleusercontent.com,yyy.apps.googleusercontent.com
# Facebook Login — dùng để xác minh access token qua Graph API /debug_token
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# (Đề xuất bổ sung) Sign in with Apple — audience = bundle id của app iOS
APPLE_BUNDLE_ID=vn.vietnamfootball.app
# (Đề xuất bổ sung) Đăng nhập Zalo
ZALO_APP_ID=
ZALO_APP_SECRET=
# Mã OTP quên mật khẩu
OTP_TTL_MIN=15
OTP_MAX_ATTEMPTS=5


# ---------- 6. EMAIL (gửi OTP) [D4] ----------
# console = chỉ in mã ra log (dev) | resend | smtp
MAIL_PROVIDER=console
MAIL_FROM="Đội tuyển Việt Nam <no-reply@example.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=


# ---------- 7. LƯU TRỮ FILE (ảnh đại diện, tài nguyên theme) [D4] ----------
# local | s3 (mọi dịch vụ tương thích S3: AWS S3, GCS interop, Cloudflare R2, MinIO)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/uploads
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=


# ---------- 8. RATE LIMIT [D5] ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
AI_RATE_LIMIT_MAX=20


# ---------- 9. TRỢ LÝ AI — LLM, RAG, CHI PHÍ [D1] ----------
LLM_PROVIDER=gemini

# ⭐ NHIỀU KEY GEMINI XOAY VÒNG — chống hết quota khi crawl/OCR hàng loạt.
# Ngăn cách bằng dấu phẩy, KHÔNG có khoảng trắng, KHÔNG xuống dòng.
#
#   GEMINI_API_KEYS=key_thu_nhat,key_thu_hai,key_thu_ba
#
# Cách hoạt động (chi tiết: backend/src/config/geminiKeyPool.ts):
#   • Mỗi lượt gọi lấy key kế tiếp theo vòng tròn -> tải rải đều.
#   • Key nào dính lỗi 429 (hết lượt) thì bị cho "nghỉ" GEMINI_KEY_COOLDOWN_MS
#     mili-giây, hệ thống tự chuyển sang key khác mà không cần khởi động lại.
#   • Hết giờ nghỉ, key tự quay lại hàng đợi.
#
# ⚠️ QUAN TRỌNG: quota tính theo DỰ ÁN Google Cloud, không theo key.
#    Tạo 5 key trong CÙNG một tài khoản thì vẫn chỉ có MỘT hạn mức.
#    Muốn nhân quota thật sự, mỗi key phải thuộc một TÀI KHOẢN GOOGLE khác nhau.
#    Lấy key miễn phí tại: https://aistudio.google.com/apikey
#
# 👉 Kiểm tra tình trạng các key bất cứ lúc nào:
#    curl http://localhost:5000/api/v1/ai/status
GEMINI_API_KEYS=

# Cách khai báo cũ, chỉ một key. Vẫn dùng được và được GỘP chung vào hồ key ở trên.
GEMINI_API_KEY=

# Key hết lượt thì nghỉ bao lâu (ms) trước khi được dùng lại. 60000 = 60 giây.
GEMINI_KEY_COOLDOWN_MS=60000

GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_PRO=gemini-3.6-pro
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=3
OPENAI_API_KEY=
OPENAI_MODEL=

# ---------- 9b. NHÚNG VECTOR & TÌM KIẾM AI [D1] ----------
# EMBEDDING_DIM phải TRÙNG với vector(768) trong migration 004_rag_vector.pg.sql.
# Đổi số này = phải nhúng lại toàn bộ kb_chunks (chạy: npm run index).
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=16
SEARCH_ENABLED=true
SEARCH_TOP_K=8
SEARCH_MIN_SCORE=0.25
RAG_CHUNK_SIZE=1400
RAG_CHUNK_OVERLAP=200

# ---------- 9c. OCR BẰNG GEMINI (đọc chữ trong ảnh/PDF) [D1] ----------
OCR_ENABLED=true
OCR_MODEL=gemini-3.6-flash
OCR_MAX_FILE_MB=15

AI_CHAT_ENABLED=true
AI_CHAT_HISTORY_TURNS=8
AI_CHAT_SUMMARY_AFTER_TURNS=12
AI_MAX_TOOL_CALLS=5
AI_DAILY_TOKEN_QUOTA_PER_USER=50000
AI_DAILY_BUDGET_USD=20
AI_RESPONSE_CACHE_TTL=300
AI_CHAT_RETENTION_DAYS=30

# ---------- 10. NGUỒN DỮ LIỆU BÓNG ĐÁ [D2] ----------
# apifootball | sportmonks — nhà cung cấp chính và dự phòng
FOOTBALL_PROVIDER=apifootball
FOOTBALL_PROVIDER_FALLBACK=
# API-Football gọi trực tiếp (api-sports.io) hoặc qua RapidAPI (khác header xác thực)
FOOTBALL_API_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_API_KEY=your_football_api_key_here
APIFOOTBALL_VIA_RAPIDAPI=false
RAPIDAPI_KEY=
RAPIDAPI_HOST=api-football-v1.p.rapidapi.com
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
SPORTMONKS_API_TOKEN=
# ID theo nhà cung cấp — PHẢI xác minh bằng endpoint /leagues, /teams trước khi dùng
VIETNAM_TEAM_ID=26
VLEAGUE1_LEAGUE_ID=
# Ngân sách request/ngày; vượt 90% => tự giãn chu kỳ polling + cảnh báo
PROVIDER_DAILY_REQUEST_BUDGET=7000
FIFA_RANKING_URL=https://www.fifa.com/fifa-world-ranking
CRAWLER_USER_AGENT=VietNamFootballBot/1.0 (+lien he: hoangoanh100720@gmail.com)
CRAWLER_TIMEOUT_MS=20000

# ---------- 10b. CÀO DỮ LIỆU CÓ ĐẠO ĐỨC [D2] ----------
# ⚖️ ĐỌC KỸ TRƯỚC KHI ĐỔI: bốn biến này không phải để trang trí.
#
# CRAWLER_RESPECT_ROBOTS=true  -> đọc /robots.txt của website và TUÂN THỦ.
#   Chỉ đặt false khi cào chính website CỦA BẠN. Phớt lờ robots.txt là cách
#   nhanh nhất để bị chặn IP vĩnh viễn, và ở nhiều nước còn là rủi ro pháp lý.
#
# CRAWLER_DELAY_MS -> nghỉ giữa hai request tới CÙNG một tên miền.
#   1500ms là mức lịch sự. Đừng hạ xuống dưới 1000 với website của người khác.
#   (Nếu robots.txt khai Crawl-delay lớn hơn, hệ thống tự dùng số lớn hơn.)
#
# CRAWLER_MAX_PAGES / CRAWLER_MAX_DEPTH -> hai cái phanh chống crawl vô tận.
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_DELAY_MS=1500
CRAWLER_MAX_PAGES=50
CRAWLER_MAX_DEPTH=2

# Danh sách URL hạt giống cho `npm run crawl` (ngăn bằng dấu phẩy, không khoảng trắng).
# Để trống thì phải truyền URL trực tiếp: npm run crawl -- https://vff.org.vn/tin-tuc/
CRAWLER_SEED_URLS=


# ---------- 11. INGESTION & HÀNG ĐỢI (BullMQ) [D2] ----------
QUEUE_PREFIX=vnf
# Chu kỳ quét trận & đội hình trong khung thi đấu (theo kế hoạch: 60 giây)
INGEST_POLL_INTERVAL_SEC=60
# Chu kỳ riêng cho tỷ số/sự kiện khi trận ĐANG LIVE (60 = giống trên; đề xuất 15)
INGEST_LIVE_INTERVAL_SEC=60
MATCHDAY_WINDOW_BEFORE_MIN=180
MATCHDAY_WINDOW_AFTER_MIN=180
LINEUP_WINDOW_BEFORE_MIN=90
INGEST_CONCURRENCY=4
# true = tự sinh diễn biến giả để thử giao diện realtime khi chưa có API key
LIVE_SIMULATION=true
# Lịch job định kỳ (giờ Asia/Ho_Chi_Minh). Chỉ tiến trình APP_ROLE=scheduler đăng ký lịch
CRON_ENABLED=true
CRON_TIMEZONE=Asia/Ho_Chi_Minh
CRON_SYNC_SQUAD=0 1 * * *
CRON_SYNC_PLAYERS=10 1 * * *
CRON_SYNC_FIXTURES=20 1 * * *
CRON_SYNC_RANKING=30 1 * * *
CRON_PLAYER_VALUE=0 3 * * *
CRON_CLEANUP=0 2 * * *
CRON_THEME_SCHEDULE=0 0 * * *
# Giá trị ước tính của cầu thủ theo phong độ (ARCHITECTURE.md mục 11.5)
# Biến động tối đa mỗi lần cập nhật (%) và số trận gần nhất dùng để tính phong độ
PLAYER_VALUE_MAX_CHANGE_PCT=10
PLAYER_VALUE_FORM_MATCHES=5


# ---------- 12. ENGINE CHẤM ĐIỂM CẦU THỦ [D3] (ARCHITECTURE.md mục 12) ----------
# Phiên bản bộ quy tắc quy đổi sự kiện → điểm đang áp dụng (bảng rating_rulesets)
RATING_RULESET_VERSION=2026.1
# engine = hiển thị điểm do app tự tính (giải thích được) | provider = điểm của nhà cung cấp
RATING_PRIMARY_SOURCE=engine
# Đá ít hơn N phút thì không chấm điểm (app hiện "–")
RATING_MIN_MINUTES=10
# Chấm điểm tạm trong lúc trận đang đá (chỉ hiện ở màn chi tiết trận)
RATING_LIVE_ENABLED=false
# Chốt điểm lần cuối sau khi hết trận (phút)
RATING_FINALIZE_AFTER_MIN=60
# Sau mốc này chỉ admin mới sửa được điểm (giờ)
RATING_CORRECTION_WINDOW_HOURS=72
# BXH cầu thủ: số phút tối thiểu trong kỳ để được xếp hạng điểm trung bình
LEADERBOARD_MIN_MINUTES=90


# ---------- 13. REALTIME — Socket.IO [D5] ----------
SOCKET_ENABLED=true
SOCKET_PATH=/socket.io
SOCKET_CORS_ORIGIN=*
# (Tương thích code cũ — livePoll.job.ts; sẽ thay bằng INGEST_LIVE_INTERVAL_SEC)
LIVE_POLLING_ENABLED=true
LIVE_POLLING_INTERVAL_MS=12000


# ---------- 14. THÔNG BÁO ĐẨY — Firebase [D5] ----------
FCM_ENABLED=false
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# Giữ nguyên dấu nháy kép và các ký tự \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nthay_bang_private_key\n-----END PRIVATE KEY-----\n"


# ---------- 15. LOG & GIÁM SÁT [D1] ----------
LOG_LEVEL=debug
LOG_DIR=./logs
SENTRY_DSN=
# Gửi trace/metrics OpenTelemetry (bỏ trống = tắt)
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=false
# Giao diện theo dõi hàng đợi (Bull Board) — chỉ bật ở dev/staging, có mật khẩu
QUEUE_DASHBOARD_ENABLED=true
QUEUE_DASHBOARD_PASSWORD=change_me


# ---------- 16. TÀI LIỆU API & KIỂM THỬ [D5] ----------
SWAGGER_ENABLED=true
SWAGGER_PATH=/docs
# Nén phản hồi lớn hơn N byte
COMPRESSION_THRESHOLD=1024
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100
# Kiểm thử tải (k6) — chỉ trỏ vào staging, không bao giờ vào production
LOADTEST_BASE_URL=http://localhost:5000/api/v1
LOADTEST_MAX_VUS=5000


# ---------- 17. MOBILE — Expo (CHỈ biến công khai EXPO_PUBLIC_*) [D6] ----------
EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_APP_NAME=Đội tuyển Việt Nam
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api/v1
EXPO_PUBLIC_SOCKET_URL=ws://192.168.1.10:5000
EXPO_PUBLIC_SOCKET_PATH=/socket.io
EXPO_PUBLIC_API_TIMEOUT=15000
EXPO_PUBLIC_LIVE_POLLING_INTERVAL=15000
EXPO_PUBLIC_SOCKET_RECONNECT_TIMEOUT=20000
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
EXPO_PUBLIC_FIREBASE_SENDER_ID=your_sender_id
# Client ID đăng nhập mạng xã hội (công khai theo bản chất, không phải secret)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ENABLE_AI_CHAT=true
